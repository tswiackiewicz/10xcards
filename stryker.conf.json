{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "ignorePatterns": [".claude", ".agents", "context"],
  "mutate": [
    "src/pages/api/flashcards/index.ts",
    "src/pages/api/flashcards/[[]id[]].ts",
    "src/pages/api/flashcards/[[]id[]]/review.ts",
    "src/pages/api/flashcards/generate.ts",
    "src/lib/flashcards/schemas.ts"
  ],
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
