---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · 10xCards` : "10xCards — AI flashcards you'll actually remember";
const description = "Paste your notes, review AI-drafted flashcards, and remember them with spaced repetition.";

// Astro.site comes from the optional SITE_URL env var (astro.config.mjs). Without it
// there is no origin to build absolute URLs from, and og:image/og:url MUST be absolute —
// so render that block only when we actually have one. Never emit `undefined/og.png`.
const siteOrigin = Astro.site?.origin ?? null;
const ogImage = siteOrigin ? new URL("/og.png", siteOrigin).href : null;
const ogUrl = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7fbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1614" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      ogImage && ogUrl && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:url" content={ogUrl} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Warning:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Documentation"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
