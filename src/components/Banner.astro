---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const VARIANT_CLASSES: Record<Variant, string> = {
  info: "border-primary/40 bg-primary/10 text-foreground",
  warning:
    "border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-200",
  error: "border-destructive/40 bg-destructive/10 text-destructive",
};
---

<div
  class:list={["border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:underline", VARIANT_CLASSES[variant]]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
