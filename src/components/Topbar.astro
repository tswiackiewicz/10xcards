---
import Logo from "@/components/Logo.astro";
import { buttonVariants } from "@/components/ui/button";

interface Props {
  /** Auth pages already put the visitor on a form — the CTAs would just point back at it. */
  hideAuthCta?: boolean;
}

const { hideAuthCta = false } = Astro.props;
const { user } = Astro.locals;
---

<header class="flex items-center justify-between gap-4 py-3">
  <a href="/" class="focus-visible:ring-ring rounded-md focus-visible:ring-2 focus-visible:outline-none">
    <Logo />
  </a>

  {
    !hideAuthCta &&
      (user ? (
        <div class="flex items-center gap-3 text-sm">
          <span class="text-muted-foreground hidden sm:inline">{user.email}</span>
          <a href="/dashboard" class="text-muted-foreground hover:text-foreground transition-colors">
            Dashboard
          </a>
          <a href="/account" class="text-muted-foreground hover:text-foreground transition-colors">
            Account
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-muted-foreground hover:text-foreground transition-colors">
              Sign out
            </button>
          </form>
        </div>
      ) : (
        <div class="flex items-center gap-2">
          <a href="/auth/signin" class:list={buttonVariants({ variant: "ghost" })}>
            Log in
          </a>
          <a href="/auth/signup" class:list={buttonVariants()}>
            Sign up free
          </a>
        </div>
      ))
  }
</header>
