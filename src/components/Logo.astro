---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <svg
    viewBox="0 0 32 32"
    class="text-primary size-7 shrink-0"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <!-- back card, offset + rotated -->
    <rect x="4" y="7" width="18" height="22" rx="4" opacity="0.35" transform="rotate(-10 13 18)"></rect>
    <!-- front card, sparkle cut out of it -->
    <path
      fill-rule="evenodd"
      clip-rule="evenodd"
      d="M14 4h11a4 4 0 0 1 4 4v16a4 4 0 0 1-4 4H14a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Zm5.5 5.5-1.1 3-3 1.1 3 1.1 1.1 3 1.1-3 3-1.1-3-1.1-1.1-3Z"
    ></path>
  </svg>
  <span class="text-lg font-semibold tracking-tight">
    <span class="text-primary">10x</span><span class="text-foreground">Cards</span>
  </span>
</span>
