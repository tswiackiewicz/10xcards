---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

// A signed-in visitor has nothing to do on the sign-in form. Middleware leaves this
// route public (anonymous visitors must reach it), so the bounce lives here.
if (Astro.locals.user) return Astro.redirect("/dashboard");

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="mx-auto flex max-w-sm flex-col items-center gap-6 px-4 py-16">
    <div class="bg-card border-border w-full max-w-sm rounded-xl border p-8 shadow-sm">
      <h1 class="text-foreground mb-6 text-center text-2xl font-semibold tracking-tight">Sign in</h1>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
