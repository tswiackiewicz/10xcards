---
import Layout from "@/layouts/Layout.astro";
import AccountView from "@/components/account/AccountView";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let pending = false;
let requestedAt: string | null = null;
if (supabase) {
  // RLS scopes this to the signed-in owner; middleware already gated the route.
  const { data } = await supabase.from("account_deletions").select("requested_at").maybeSingle();
  if (data) {
    pending = true;
    requestedAt = data.requested_at;
  }
}
---

<Layout title="Account">
  <div class="mx-auto max-w-2xl px-4 py-6">
    <header class="flex items-center justify-between py-6">
      <h1 class="text-foreground text-2xl font-semibold tracking-tight">Account</h1>
      <a href="/dashboard" class="text-muted-foreground hover:text-foreground text-sm transition-colors">← Dashboard</a>
    </header>
    <AccountView client:load pending={pending} requestedAt={requestedAt} email={user?.email ?? null} />
  </div>
</Layout>
