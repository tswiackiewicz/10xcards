---
import Layout from "@/layouts/Layout.astro";
import SavedCardsView from "@/components/flashcards/SavedCardsView";
import { createClient } from "@/lib/supabase";
import type { Flashcard } from "@/lib/flashcards/schemas";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let cards: Flashcard[] = [];
if (supabase) {
  // RLS scopes this to the signed-in owner; middleware already gated the route.
  const { data } = await supabase.from("flashcards").select("*").order("created_at", { ascending: false });
  cards = data ?? [];
}
---

<Layout title="My flashcards">
  <div class="mx-auto max-w-3xl px-4 py-6">
    <header class="flex items-center justify-between py-6">
      <h1 class="text-foreground text-2xl font-semibold tracking-tight">My flashcards</h1>
      <a href="/dashboard" class="text-muted-foreground hover:text-foreground text-sm transition-colors">← Dashboard</a>
    </header>
    <SavedCardsView client:load cards={cards} />
  </div>
</Layout>
