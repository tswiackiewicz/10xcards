---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;

const TILES = [
  { href: "/generate", label: "Generate flashcards" },
  { href: "/create", label: "Create flashcard" },
  { href: "/cards", label: "My flashcards" },
  { href: "/study", label: "Study" },
  { href: "/account", label: "Account" },
];
---

<Layout title="Dashboard">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-foreground text-2xl font-semibold tracking-tight">Dashboard</h1>
    <p class="text-muted-foreground mt-2">
      Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
    </p>
    <p class="text-muted-foreground mt-1 text-sm">Pick up where you left off.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        TILES.map((tile) => (
          <a
            href={tile.href}
            class="bg-card border-border hover:bg-accent inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
          >
            {tile.label}
          </a>
        ))
      }
    </div>
    <form method="POST" action="/api/auth/signout" class="mt-6">
      <button
        type="submit"
        class="bg-card border-border hover:bg-accent rounded-lg border px-4 py-2 text-sm transition-colors"
      >
        Sign out
      </button>
    </form>
  </div>
</Layout>
