---
import Layout from "@/layouts/Layout.astro";
import GenerateView from "@/components/flashcards/GenerateView";
---

<Layout title="Generate flashcards">
  <div class="mx-auto max-w-3xl px-4 py-6">
    <header class="flex items-center justify-between py-6">
      <h1 class="text-foreground text-2xl font-semibold tracking-tight">Generate flashcards</h1>
      <a href="/dashboard" class="text-muted-foreground hover:text-foreground text-sm transition-colors">← Dashboard</a>
    </header>
    <div class="bg-card border-border rounded-xl border p-6">
      <GenerateView client:load />
    </div>
  </div>
</Layout>
